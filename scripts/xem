#!/bin/bash
# Open a markdown file (or piped markdown) in Xem.app.
set -euo pipefail

# Locate the app bundle: $XEM_APP if set (e.g. a dev build), else the
# `make install` copy in /Applications.
resolve_app() {
    local app="${XEM_APP:-/Applications/Xem.app}"
    [ -d "$app" ] || return 1
    printf '%s' "$(cd "$app" && pwd)"
}

if ! APP="$(resolve_app)"; then
    if [ -n "${XEM_APP:-}" ]; then
        echo "xem: XEM_APP is set to '$XEM_APP', which is not an app bundle." >&2
    else
        echo "xem: /Applications/Xem.app not found." >&2
        echo "         Set XEM_APP to its path, or run 'make install'." >&2
    fi
    exit 1
fi

usage() {
    cat >&2 <<'EOF'
usage: xem [--attach | --term] <file.md>
       xem [--attach | --term] -      (or pipe into xem)

  --attach   view in a new iTerm2 tab instead of a window
  --term     view in this terminal (iTerm2 inline images)
EOF
    exit 2
}

mode="window"
case "${1:-}" in
    --attach|-a) mode="attach"; shift ;;
    --term|-t)   mode="term"; shift ;;
esac

target=""

if [ $# -eq 0 ]; then
    # No argument: only meaningful if something is piped in.
    if [ -t 0 ]; then usage; fi
    target="-"
elif [ $# -eq 1 ]; then
    case "$1" in
        -h|--help) usage ;;
        *) target="$1" ;;
    esac
else
    usage
fi

if [ "$target" = "-" ]; then
    tmp="${TMPDIR:-/tmp}/xem-$$-stdin.md"
    cat > "$tmp"
    [ -s "$tmp" ] || { rm -f "$tmp"; echo "xem: empty input" >&2; exit 1; }
    abs="$tmp"
else
    [ -e "$target" ] || { echo "xem: no such file: $target" >&2; exit 1; }
    [ -f "$target" ] || { echo "xem: not a regular file: $target" >&2; exit 1; }
    # Resolve to an absolute path; `open` is not reliably cwd-relative.
    abs="$(cd "$(dirname "$target")" && pwd)/$(basename "$target")"
fi

BIN="$APP/Contents/MacOS/xem"

# Single-quote one argument for iTerm2, which splits a session command itself
# (shell-style quoting, but no shell).
quote() {
    local escaped
    escaped="$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
    printf "'%s'" "$escaped"
}

case "$mode" in
    term)
        exec "$BIN" --term "$abs"
        ;;
    attach)
        if ! osascript -e 'id of application "iTerm"' >/dev/null 2>&1; then
            echo "xem: --attach needs iTerm2; opening a window instead." >&2
            exec open -a "$APP" "$abs"
        fi
        cmd="$(quote "$BIN") --term $(quote "$abs")"
        exec osascript - "$cmd" >/dev/null <<'APPLESCRIPT'
on run argv
    set cmd to item 1 of argv
    tell application "iTerm"
        if (count of windows) is 0 then
            create window with default profile command cmd
        else
            tell current window to create tab with default profile command cmd
        end if
        activate
    end tell
end run
APPLESCRIPT
        ;;
    *)
        exec open -a "$APP" "$abs"
        ;;
esac
