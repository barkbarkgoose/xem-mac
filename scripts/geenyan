#!/bin/bash
# Open a markdown file (or piped markdown) in Geenyan.app.
set -euo pipefail

# Locate the app bundle. Homebrew installs it alongside this script inside the
# Cellar, so look there first; fall back to a normal /Applications install.
resolve_app() {
    if [ -n "${GEENYAN_APP:-}" ]; then
        [ -d "$GEENYAN_APP" ] || return 1
        printf '%s' "$GEENYAN_APP"
        return
    fi

    # Follow symlinks to this script's real location (BSD readlink has no -f).
    local src="${BASH_SOURCE[0]}" dir
    while [ -L "$src" ]; do
        dir="$(cd -P "$(dirname "$src")" && pwd)"
        src="$(readlink "$src")"
        [[ $src != /* ]] && src="$dir/$src"
    done
    dir="$(cd -P "$(dirname "$src")" && pwd)"

    for candidate in "$dir/../Geenyan.app" "$dir/../../Geenyan.app" "/Applications/Geenyan.app"; do
        if [ -d "$candidate" ]; then
            printf '%s' "$(cd "$candidate" && pwd)"
            return
        fi
    done
    return 1
}

if ! APP="$(resolve_app)"; then
    if [ -n "${GEENYAN_APP:-}" ]; then
        echo "geenyan: GEENYAN_APP is set to '$GEENYAN_APP', which is not an app bundle." >&2
    else
        echo "geenyan: Geenyan.app not found (looked next to this script and in /Applications)." >&2
        echo "         Set GEENYAN_APP to its path, or run 'make install'." >&2
    fi
    exit 1
fi

usage() { echo "usage: geenyan <file.md> | geenyan -   (or pipe into geenyan)" >&2; exit 2; }

target=""

if [ $# -eq 0 ]; then
    # No argument: only meaningful if something is piped in.
    if [ -t 0 ]; then usage; fi
    target="-"
elif [ $# -eq 1 ]; then
    case "$1" in
        -h|--help) usage ;;
        *) target="$1" ;;
    esac
else
    usage
fi

if [ "$target" = "-" ]; then
    tmp="${TMPDIR:-/tmp}/geenyan-$$-stdin.md"
    cat > "$tmp"
    [ -s "$tmp" ] || { rm -f "$tmp"; echo "geenyan: empty input" >&2; exit 1; }
    abs="$tmp"
else
    [ -e "$target" ] || { echo "geenyan: no such file: $target" >&2; exit 1; }
    [ -f "$target" ] || { echo "geenyan: not a regular file: $target" >&2; exit 1; }
    # Resolve to an absolute path; `open` is not reliably cwd-relative.
    abs="$(cd "$(dirname "$target")" && pwd)/$(basename "$target")"
fi

exec open -a "$APP" "$abs"
